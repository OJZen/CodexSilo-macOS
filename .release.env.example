# Copy this file to .release.env and fill in your own values.
# The .release.env file is gitignored on purpose.

PROJECT_PATH=CodexSilo.xcodeproj
SCHEME=CodexSilo
CONFIGURATION=Release
DESTINATION=generic/platform=macOS

# Set these to your own Apple Developer values.
DEVELOPMENT_TEAM=YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER=com.example.codexsilo
NOTARY_PROFILE=codexsilo-notary

# Optional toggles.
NOTARIZE=1
ALLOW_PROVISIONING_UPDATES=0
KEEP_WORK_ROOT=0
OUTPUT_ROOT=build/release

# Optional GitHub release publishing settings.
TAG_PREFIX=
RELEASE_TITLE_PREFIX=CodexSilo
PUSH_TAG=1
SKIP_BUILD=0
ALLOW_DIRTY=0
